<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only (resource overlay over src/main): cleartext HTTP is
  permitted ONLY for the local demo origin (and loopback), so the demo
  artifact (signed for http://10.110.147.178:8000) can be tried on a device
  without a TLS certificate. The JS layer additionally gates http:// joins
  on the debuggable flag (KeryxEnv), so release builds reject them before
  any fetch happens.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.110.147.178</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
