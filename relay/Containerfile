# Relay image (relay/README.md "Deploy to Fly.io"): the relay is pure Go
# (modernc.org/sqlite), so CGO can stay off and the binary is static.
FROM golang:1.26 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/relay ./cmd/relay

# Distroless static ships the CA bundle the outbound policy needs. It runs as
# root so the Fly volume mounted at /data is writable.
FROM gcr.io/distroless/static-debian12
COPY --from=build /out/relay /relay
EXPOSE 8080
ENTRYPOINT ["/relay", "serve"]
